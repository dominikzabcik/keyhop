{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchr",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Served at https://keyhop.app, with the workers.dev address kept as a fallback. Per-version
  // preview URLs stay off. The Worker itself keeps its original name: renaming it would create a
  // different Worker and leave the live one, and its database, behind.
  "routes": [{ "pattern": "keyhop.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ratelimits": [
    {
      "name": "DEVICE_START_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "DEVICE_POLL_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // Per signed-in account: a computer syncs hourly and shares limits every few minutes, so
      // sixty writes a minute is far above honest use and still bounds a runaway client.
      "name": "UPLOAD_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Hourly: sweep limit readings nobody has refreshed in a day.
  "triggers": { "crons": ["17 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "switchr",
      // From `npx wrangler d1 create switchr`. Local development ignores it.
      "database_id": "6e491730-0672-40e6-a04b-3ffe14ff4c95",
      "migrations_dir": "migrations"
    }
  ]
}
