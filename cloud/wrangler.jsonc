{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "switchr",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Served at https://switchr.qwezdi.workers.dev. Per-version preview URLs stay off.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "switchr",
      // From `npx wrangler d1 create switchr`. Local development ignores it.
      "database_id": "6e491730-0672-40e6-a04b-3ffe14ff4c95",
      "migrations_dir": "migrations"
    }
  ]
}
