pkgname=keyhop-bin
pkgver=0.12.0
pkgrel=1
pkgdesc="Switch AI coding accounts in one click and track exact usage where available."
arch=('x86_64' 'aarch64')
url="https://github.com/dominikzabcik/keyhop"
license=('MIT')
depends=('python-gobject' 'gtk3' 'libayatana-appindicator' 'libnotify' 'libsecret' 'ca-certificates')
optdepends=('webkit2gtk-4.1: Keyhop window inside the tray instead of a browser window')
provides=('keyhop')
conflicts=('keyhop')
options=('!strip' '!debug')
source_x86_64=("https://github.com/dominikzabcik/keyhop/releases/download/v$pkgver/keyhop-$pkgver-linux-x86_64.tar.gz")
sha256sums_x86_64=('74e3c7468ffc38844cbd6de9f8d407352daa6cd4844ebf8bdd81a00774dd466b')
