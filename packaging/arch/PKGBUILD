# Generated by scripts/render-manifests.py for each release.
pkgname=switchr-bin
pkgver=0.7.1
pkgrel=1
pkgdesc="Switch Claude Code, Cursor and Codex accounts in one click and track their usage."
arch=('x86_64' 'aarch64')
url="https://github.com/dominikzabcik/switchr"
license=('MIT')
depends=('python-gobject' 'gtk3' 'libayatana-appindicator' 'libnotify' 'libsecret' 'ca-certificates')
optdepends=('webkit2gtk-4.1: Switchr window inside the tray instead of a browser window')
provides=('switchr')
conflicts=('switchr')
options=('!strip' '!debug')
source_x86_64=("https://github.com/dominikzabcik/switchr/releases/download/v$pkgver/switchr-$pkgver-linux-x86_64.tar.gz")
sha256sums_x86_64=('4d343e885807eea04151ef4772a584135784d727be82e2ee254e6dcaba7be580')
source_aarch64=("https://github.com/dominikzabcik/switchr/releases/download/v$pkgver/switchr-$pkgver-linux-aarch64.tar.gz")
sha256sums_aarch64=('912dfaa2626cb9f5b15b283f8577487eae4b893e44655547e22a145d9087dad9')

package() {
  cd "switchr-$pkgver"
  install -Dm755 switchr "$pkgdir/usr/bin/switchr"
  install -Dm755 switchr-tray "$pkgdir/usr/bin/switchr-tray"
  install -Dm644 dev.switchr.Switchr.desktop "$pkgdir/usr/share/applications/dev.switchr.Switchr.desktop"
  install -Dm644 dev.switchr.Switchr.metainfo.xml "$pkgdir/usr/share/metainfo/dev.switchr.Switchr.metainfo.xml"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "icons/switchr-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/dev.switchr.Switchr.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
