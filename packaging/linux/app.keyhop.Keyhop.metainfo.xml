<component type="desktop-application">
  <id>app.keyhop.Keyhop</id>
  <metadata_license>MIT</metadata_license>
  <project_license>MIT</project_license>
  <name>Keyhop</name>
  <summary>Switch AI coding accounts and track their usage</summary>
  <developer id="io.github.dominikzabcik">
    <name>dominikzabcik</name>
  </developer>
  <description>
    <p>
      Keyhop keeps accounts for nine supported AI coding tools on one computer and
      moves a tool to another account in one click, so you can keep working when one account's limit
      runs out.
    </p>
    <p>
      It reads supported limits with each account's own login, tracks exact token records for six
      tools and their value at API prices, and warns before a limit or budget runs out.
    </p>
  </description>
  <launchable type="desktop-id">app.keyhop.Keyhop.desktop</launchable>
  <url type="homepage">https://github.com/dominikzabcik/keyhop</url>
  <url type="bugtracker">https://github.com/dominikzabcik/keyhop/issues</url>
  <provides>
    <binary>keyhop</binary>
    <binary>keyhop-tray</binary>
  </provides>
  <categories>
    <category>Development</category>
    <category>Utility</category>
  </categories>
