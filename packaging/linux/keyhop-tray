#!/usr/bin/python3
"""Keyhop's Linux tray: the accounts menu, limit icon, prompts and alerts.

Everything it shows comes from `keyhop ... --json`, the same contract the Windows tray uses.
Needs PyGObject with GTK 3, libayatana-appindicator (or libappindicator) and libnotify.

    keyhop-tray                          run the tray
    keyhop-tray --print-menu FILE        print the menu for a saved `keyhop status --json` (no GTK needed)
    keyhop-tray --status-file FILE       show saved data instead of running keyhop
      --show-menu, --show-dialog          with --status-file: open the menu or a prompt, for screenshots
"""

import json
import os
import shutil
import subprocess
import sys
import threading
import urllib.parse
import urllib.request
from datetime import datetime, timezone

APP_ID = "app.keyhop.Keyhop"
REFRESH_SECONDS = 5 * 60
UPDATE_CHECK_SECONDS = 12 * 60 * 60
# The dashboard's text and background, for the icon on dark and light panels.
LIGHT_INK = "#EBEBEB"
DARK_INK = "#171717"
READING = "Reading limits…"


def cli_path():
    here = os.path.dirname(os.path.realpath(__file__))
    beside = os.path.join(here, "keyhop")
    if os.access(beside, os.X_OK) and not os.path.isdir(beside):
        return beside
    return shutil.which("keyhop") or "keyhop"


def config_dir():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "keyhop")


def parse_date(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


class Settings:
    """The tray's own settings, in ~/.config/keyhop/tray.json. `keyhop reset` removes the folder."""

    defaults = {"autoRefresh": True, "autoInstallUpdates": True, "notifiedVersion": ""}

    def __init__(self):
        self.path = os.path.join(config_dir(), "tray.json")
        self.values = dict(self.defaults)
        try:
            with open(self.path, encoding="utf-8") as handle:
                self.values.update(json.load(handle))
        except (OSError, ValueError):
            pass

    def __getitem__(self, key):
        return self.values.get(key, self.defaults.get(key))

    def __setitem__(self, key, value):
        self.values[key] = value
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        with open(self.path, "w", encoding="utf-8") as handle:
            json.dump(self.values, handle, indent=2)


# MARK: Menu model (no GTK)


def tokens(count):
    for limit, suffix in ((1e9, "B"), (1e6, "M"), (1e3, "K")):
        if count >= limit:
            number = count / limit
            text = f"{number:.0f}" if number >= 100 else f"{number:.1f}"
            return (text[:-2] if text.endswith(".0") else text) + suffix
    return str(count)


def usd(amount):
    return f"${amount:.0f}" if amount >= 100 else f"${amount:.2f}"


def relative(moment, now=None):
    now = now or datetime.now(timezone.utc)
    seconds = int((now - moment).total_seconds())
    if seconds < 60:
        return "just now"
    if seconds < 3600:
        return f"{seconds // 60} min ago"
    if seconds < 86400:
        return f"{seconds // 3600} h ago"
    return f"{seconds // 86400} d ago"


def account_detail(account, recommended=False):
    prefix = "Smart Hop · " if recommended else ""
    limits = account.get("limits") or []
    if limits:
        tightest = max(limits, key=lambda limit: limit["usedPercent"])
        return f"{prefix}{round(tightest['usedPercent'])}% of {tightest['label']}"
    if account.get("error"):
        return "limits unavailable"
    return prefix + (account.get("plan") or "")


def overall_budget(status):
    return next((b for b in (status or {}).get("budgets", []) if b.get("scope") == "all"), None)


def find_account(status, account_id):
    for tool in (status or {}).get("tools", []):
        for account in tool["accounts"]:
            if account["id"] == account_id:
                return tool, account
    return None, None


def budget_amount(text):
    """None for invalid input, 0 for no budget, otherwise dollars."""
    cleaned = text.strip().replace("$", "").replace(",", "")
    if not cleaned:
        return 0
    try:
        value = float(cleaned)
    except ValueError:
        return None
    return value if value > 0 else None


def build_menu(status, busy=None, update=None, settings=None):
    """A list of dicts: {title, command, checked, enabled, children} or {separator: True}."""
    settings = settings or {"autoRefresh": True, "autoInstallUpdates": True, "autostart": False, "canSelfUpdate": True}
    idle = busy is None
    items = [{"title": "Open Keyhop", "command": ("dashboard",)}, {"separator": True}]
    if busy:
        items += [{"title": busy, "enabled": False}, {"separator": True}]
    if status:
        recommended = {entry["account"] for entry in status.get("recommendations", [])}
        for tool in status["tools"]:
            items.append({"title": tool["name"], "enabled": False})
            for account in tool["accounts"]:
                detail = account_detail(account, not account["active"] and account["id"] in recommended)
                items.append({
                    "title": account["name"] + (f"  ·  {detail}" if detail else ""),
                    "command": None if account["active"] else ("switch", account["id"]),
                    "checked": account["active"],
                    "enabled": idle or account["active"],
                })
            label = "Add account…" if tool["accounts"] else "Save the signed-in account…"
            items.append({"title": label, "command": ("add", tool["id"]), "enabled": idle})
            items.append({"separator": True})
        today = status.get("today") or {}
        if today.get("requests"):
            items.append({"title": f"Today: {tokens(today['tokens'])} tokens, {usd(today['cost'])} at API prices", "enabled": False})
        read = parse_date(status.get("refreshedAt"))
        items.append({"title": f"Limits read {relative(read)}" if read else "Limits not read yet", "enabled": False})
    else:
        items.append({"title": "Reading your accounts…", "enabled": False})

    items.append({"title": "Refresh now", "command": ("refresh",), "enabled": idle})
    if status:
        manage = []
        for tool in status["tools"]:
            for account in tool["accounts"]:
                manage.append({"title": f"{tool['name']}: {account['name']}", "children": [
                    {"title": "Rename…", "command": ("rename", account["id"]), "enabled": idle},
                    {"title": "Remove… (in use)" if account["active"] else "Remove…", "command": ("remove", account["id"]),
                     "enabled": idle and not account["active"]},
                ]})
        if manage:
            items.append({"title": "Accounts", "children": manage})
        budget = overall_budget(status)
        title = f"Budget: {usd(budget['spent'])} of {usd(budget['amount'])} per {budget['period']}…" if budget else "Set a budget…"
        items.append({"title": title, "command": ("budget",), "enabled": idle})

    items.append({"separator": True})
    items.append({"title": "Check usage automatically", "command": ("auto-refresh",), "checked": settings["autoRefresh"], "toggle": True})
    if settings["canSelfUpdate"]:
        # Only the ~/.local build installs updates without a password prompt.
        items.append({"title": "Install updates automatically", "command": ("auto-install",), "checked": settings["autoInstallUpdates"], "toggle": True})
    items.append({"title": "Open at login", "command": ("autostart",), "checked": settings["autostart"], "toggle": True})
    if update and update.get("available"):
        items.append({"title": f"Update to {update['latest']}", "command": ("install-update",), "enabled": idle})
    else:
        version = (status or {}).get("version") or (update or {}).get("current") or "…"
        items.append({"title": f"Check for updates ({version})", "command": ("check-update",), "enabled": idle})
    items.append({"title": "Quit Keyhop", "command": ("quit",)})
    return items


def glyph_values(status):
    """The account in use that's closest to a limit: its first two limits, 0 to 1."""
    best = None
    for tool in (status or {}).get("tools", []):
        for account in tool["accounts"]:
            if account["active"] and account.get("limits"):
                peak = max(limit["usedPercent"] for limit in account["limits"])
                if best is None or peak > best[0]:
                    best = (peak, account)
    if not best:
        return []
    return [limit["usedPercent"] / 100 for limit in best[1]["limits"][:2]]


def glyph_levels(values):
    """Lit squares per row, 0 to 4. With no limits read it's the logo: three on top, one below."""
    if not values:
        return [3, 1]
    levels = []
    for row in range(2):
        value = values[row] if row < len(values) else None
        levels.append(0 if value is None else min(max(value, 0), 1) * 4)
    return levels


def glyph_svg(values, color):
    """Keyhop's pixel mark, as in the dashboard and the Mac menu bar: two rows of four squares,
    each row lit as far as one of the two nearest limits is used."""
    levels = glyph_levels(values)
    parts = ['<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 22 22">']
    for row, y in enumerate((5, 13)):
        for column in range(4):
            lit = min(max(levels[row] - column, 0), 1)
            parts.append(f'<rect x="{column * 6}" y="{y}" width="4" height="4" rx="1" fill="{color}" fill-opacity="{0.3 + 0.7 * lit:.3f}"/>')
    parts.append("</svg>")
    return "".join(parts)


def tooltip(status):
    lines = ["Keyhop"]
    for tool in (status or {}).get("tools", []):
        for account in tool["accounts"]:
            if account["active"] and account.get("limits"):
                tightest = max(account["limits"], key=lambda limit: limit["usedPercent"])
                lines.append(f"{tool['name']}: {round(tightest['usedPercent'])}% of {tightest['label']}")
    return "\n".join(lines)


def print_menu(path):
    with open(path, encoding="utf-8") as handle:
        status = json.load(handle)

    def show(items, depth):
        for item in items:
            indent = "    " * depth
            if item.get("separator"):
                print(f"{indent}  ----")
                continue
            mark = "✓" if item.get("checked") else " "
            label = item.get("command") is None and not item.get("children") and not item.get("checked")
            note = "  (label)" if label else ("" if item.get("enabled", True) else "  (disabled)")
            arrow = "  ▸" if item.get("children") else ""
            print(f"{indent}{mark} {item['title']}{arrow}{note}")
            show(item.get("children", []), depth + 1)

    show(build_menu(status, settings={"autoRefresh": True, "autoInstallUpdates": True, "autostart": True, "canSelfUpdate": True}), 0)
    print("Tooltip:", tooltip(status).replace("\n", " | "))


# MARK: Tray


def run_tray(argv):
    import fcntl
    import gi

    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, Gio, GLib, Gtk

    indicator_module = None
    for name in ("AyatanaAppIndicator3", "AppIndicator3"):
        try:
            gi.require_version(name, "0.1")
            indicator_module = __import__("gi.repository", fromlist=[name]).__dict__[name]
            break
        except (ValueError, ImportError, KeyError):
            continue
    if indicator_module is None:
        sys.stderr.write(
            "keyhop-tray needs libayatana-appindicator:\n"
            "  Fedora: sudo dnf install libayatana-appindicator-gtk3\n"
            "  Debian/Ubuntu: sudo apt install gir1.2-ayatanaappindicator3-0.1\n"
            "  Arch: sudo pacman -S libayatana-appindicator\n"
        )
        return 1

    try:
        gi.require_version("Notify", "0.7")
        from gi.repository import Notify
    except (ValueError, ImportError):
        Notify = None

    def load_webkit():
        for version in ("4.1", "4.0"):
            try:
                gi.require_version("WebKit2", version)
                from gi.repository import WebKit2
                return WebKit2
            except (ValueError, ImportError):
                continue
        return None

    fixture = argv[argv.index("--status-file") + 1] if "--status-file" in argv and argv.index("--status-file") + 1 < len(argv) else None

    runtime = os.environ.get("XDG_RUNTIME_DIR") or os.path.join("/tmp", f"keyhop-{os.getuid()}")
    icon_dir = os.path.join(runtime, "keyhop")
    os.makedirs(icon_dir, mode=0o700, exist_ok=True)
    lock = open(os.path.join(icon_dir, "tray.lock"), "w")
    if not fixture:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            if "--after-update" not in argv:
                print("Keyhop's tray is already running.")
                return 0
            fcntl.flock(lock, fcntl.LOCK_EX)

    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    autostart_file = os.path.join(config, "autostart", f"{APP_ID}.desktop")
    Gtk.Window.set_default_icon_name(APP_ID)

    def prompt(title, message, initial, action="Save"):
        dialog = Gtk.Dialog(title=title, modal=True)
        dialog.set_keep_above(True)
        dialog.set_position(Gtk.WindowPosition.CENTER)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, action, Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_border_width(18)
        label = Gtk.Label(label=message, xalign=0)
        label.set_line_wrap(True)
        label.set_max_width_chars(46)
        entry = Gtk.Entry()
        entry.set_text(initial)
        entry.set_activates_default(True)
        box.add(label)
        box.add(entry)
        dialog.show_all()
        response = dialog.run()
        text = entry.get_text()
        dialog.destroy()
        return text if response == Gtk.ResponseType.OK else None

    def confirm(title, message, action):
        dialog = Gtk.MessageDialog(modal=True, message_type=Gtk.MessageType.WARNING, buttons=Gtk.ButtonsType.NONE, text=title)
        dialog.format_secondary_text(message)
        dialog.set_keep_above(True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, action, Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    class Tray:
        def __init__(self):
            self.status = None
            self.update = None
            self.busy = None
            self.icon_path = None
            self.window = None
            self.notifications = []
            self.settings = Settings()
            self.cli = cli_path()
            self.indicator = indicator_module.Indicator.new(APP_ID, "", indicator_module.IndicatorCategory.APPLICATION_STATUS)
            self.indicator.set_status(indicator_module.IndicatorStatus.ACTIVE)
            self.indicator.set_title("Keyhop")
            if Notify:
                Notify.init("Keyhop")

            if fixture:
                with open(fixture, encoding="utf-8") as handle:
                    self.status = json.load(handle)
                self.render()
                if "--show-menu" in argv:
                    GLib.timeout_add(600, self.show_menu_for_screenshot)
                if "--show-dialog" in argv:
                    first = next((a for t in self.status["tools"] for a in t["accounts"]), None)
                    if first:
                        GLib.timeout_add(600, lambda: self.perform(("rename", first["id"])) and False)
                return

            self.render()
            self.load(["status", "--json"], then=lambda: self.settings["autoRefresh"] and self.refresh(claim=True))
            GLib.timeout_add_seconds(REFRESH_SECONDS, self.on_timer)
            GLib.timeout_add_seconds(UPDATE_CHECK_SECONDS, self.on_update_timer)
            self.check_update(announce=False)
            GLib.timeout_add_seconds(3, self.check_tray_host)

        @property
        def can_self_update(self):
            # Packages update through the package manager's password prompt; the ~/.local build doesn't need one.
            return os.path.realpath(self.cli).startswith(os.path.realpath(os.path.expanduser("~")) + os.sep)

        def menu_settings(self):
            return {
                "autoRefresh": self.settings["autoRefresh"],
                "autoInstallUpdates": self.settings["autoInstallUpdates"],
                "autostart": os.path.exists(autostart_file),
                # Packages still install updates from the menu, through the system's password prompt.
                "canSelfUpdate": self.can_self_update,
            }

        # Running keyhop

        def run(self, arguments, done):
            if fixture:
                return

            def work():
                try:
                    result = subprocess.run([self.cli] + arguments, capture_output=True, timeout=900)
                    outcome = (result.returncode, result.stdout, result.stderr.decode("utf-8", "replace"))
                except (OSError, subprocess.TimeoutExpired) as error:
                    outcome = (1, b"", str(error))
                GLib.idle_add(lambda: done(*outcome) and False)

            threading.Thread(target=work, daemon=True).start()

        # Keyhop's window

        def open_dashboard(self):
            """Shows the dashboard in a WebKit window when WebKitGTK is installed, otherwise lets
            keyhop open it in a browser app window."""
            if self.window is not None:
                self.window.present()
                return
            webkit = load_webkit()
            if webkit is None:
                subprocess.Popen([self.cli, "dashboard"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
                return

            def start():
                try:
                    server = subprocess.Popen([self.cli, "dashboard", "--no-open", "--json"], stdin=subprocess.DEVNULL,
                                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
                    url = json.loads(server.stdout.readline())["url"]
                except (OSError, ValueError, KeyError) as error:
                    GLib.idle_add(lambda: self.notify("Couldn't open Keyhop", str(error)) and False)
                    return
                GLib.idle_add(lambda: self.show_window(webkit, url) and False)

            threading.Thread(target=start, daemon=True).start()

        def show_window(self, webkit, url):
            window = Gtk.Window(title="Keyhop")
            window.set_default_size(1360, 900)
            window.set_icon_name(APP_ID)
            view = webkit.WebView()
            view.set_background_color(Gdk.RGBA(0.03, 0.07, 0.05, 1))
            view.load_uri(url)
            window.add(view)
            window.connect("destroy", lambda _window: self.close_dashboard(url))
            window.show_all()
            self.window = window

        def close_dashboard(self, url):
            """Stops the dashboard's server when its window closes."""
            self.window = None
            parts = urllib.parse.urlsplit(url)
            token = urllib.parse.parse_qs(parts.fragment).get("k", [""])[0]
            request = urllib.request.Request(f"http://{parts.netloc}/api/close", data=b"{}", method="POST",
                                             headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
            try:
                urllib.request.urlopen(request, timeout=2).close()
            except OSError:
                pass

        def after_edit(self, failure):
            """Reloads the accounts after a rename, removal or budget change, and reports a failure."""
            def done(code, _stdout, stderr):
                if code != 0:
                    self.notify(failure, self.error_text(code, stderr))
                self.load(["status", "--json"])
            return done

        @staticmethod
        def error_text(code, stderr):
            text = stderr.strip()
            if text.startswith("keyhop: "):
                text = text[len("keyhop: "):]
            return text[:300] or f"keyhop exited with code {code}."

        def load(self, arguments, then=None):
            def done(code, stdout, stderr):
                if code == 0:
                    try:
                        self.status = json.loads(stdout)
                    except ValueError:
                        pass
                elif self.status is None:
                    self.notify("Keyhop couldn't read your accounts", self.error_text(code, stderr))
                self.render()
                if then:
                    then()

            self.run(arguments, done)

        def refresh(self, claim=False):
            arguments = ["refresh", "--json"] + (["--claim-alerts"] if claim else [])
            if self.busy is None:
                self.busy = READING
                self.render()

            def after():
                if self.busy == READING:
                    self.busy = None
                    self.render()
                for alert in (self.status or {}).get("alerts", []):
                    self.notify(alert["title"], alert["body"], switch_to=alert.get("switchTo"))

            self.load(arguments, then=after)

        def check_update(self, announce):
            def done(code, stdout, stderr):
                if code != 0:
                    if announce:
                        self.notify("Couldn't check for updates", self.error_text(code, stderr))
                    return
                try:
                    self.update = json.loads(stdout)
                except ValueError:
                    return
                self.render()
                latest = self.update.get("latest")
                if self.update.get("available"):
                    if self.can_self_update and self.settings["autoInstallUpdates"]:
                        self.install_update()
                    elif announce or self.settings["notifiedVersion"] != latest:
                        self.settings["notifiedVersion"] = latest
                        self.notify(f"Keyhop {latest} is available", "Choose Update in the menu. Your system asks for your password to install it.")
                elif announce:
                    self.notify("Keyhop", f"Keyhop {self.update['current']} is the latest version.")

            self.run(["update", "--check", "--json"], done)

        def install_update(self):
            if self.busy is not None or not (self.update or {}).get("available"):
                return
            self.busy = f"Installing Keyhop {self.update['latest']}…"
            self.render()

            def done(code, _stdout, stderr):
                self.busy = None
                if code != 0:
                    self.notify("Keyhop didn't update", self.error_text(code, stderr))
                    self.render()
                    return
                lock.close()
                os.execv(os.path.realpath(__file__), [os.path.realpath(__file__), "--after-update"])

            self.run(["update", "--json"], done)

        def on_timer(self):
            if self.settings["autoRefresh"]:
                self.refresh(claim=True)
            return True

        def on_update_timer(self):
            self.check_update(announce=False)
            return True

        def check_tray_host(self):
            """GNOME hides tray icons unless the AppIndicator extension is on; say so once."""
            try:
                bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
                reply = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
                                      GLib.Variant("(s)", ("org.kde.StatusNotifierWatcher",)), None, Gio.DBusCallFlags.NONE, 2000, None)
                has_host = reply.unpack()[0]
            except GLib.Error:
                return False
            if not has_host and not self.settings.values.get("trayHostHintShown"):
                self.notify("Keyhop is running, but your desktop hides tray icons",
                            "On GNOME, turn on the AppIndicator and KStatusNotifierItem extension, then log out and back in.")
                self.settings["trayHostHintShown"] = True
            return False

        # Notifications

        def notify(self, title, body, switch_to=None):
            if not Notify:
                print(f"{title}: {body}")
                return
            note = Notify.Notification.new(title, body, APP_ID)
            note.set_hint("desktop-entry", GLib.Variant("s", APP_ID))
            if switch_to:
                note.add_action("switch", "Switch", lambda *_: self.perform(("switch", switch_to)))
            note.connect("closed", lambda n: self.notifications.remove(n) if n in self.notifications else None)
            self.notifications.append(note)
            try:
                note.show()
            except GLib.Error:
                pass

        # Icon and menu

        def render(self):
            dark_panel = os.environ.get("KEYHOP_TRAY_ICON", "light") != "dark"
            svg = glyph_svg(glyph_values(self.status), LIGHT_INK if dark_panel else DARK_INK)
            # A new file name per change: indicator hosts cache icons by path.
            path = os.path.join(icon_dir, f"glyph-{abs(hash(svg))}.svg")
            if path != self.icon_path:
                with open(path, "w", encoding="utf-8") as handle:
                    handle.write(svg)
                old = self.icon_path
                self.icon_path = path
                self.indicator.set_icon_full(path, tooltip(self.status).replace("\n", ", "))
                if old and os.path.exists(old):
                    GLib.timeout_add_seconds(5, lambda: (os.remove(old) if os.path.exists(old) else None) and False)
            self.menu = self.build(build_menu(self.status, self.busy, self.update, self.menu_settings()))
            self.indicator.set_menu(self.menu)

        def build(self, items):
            menu = Gtk.Menu()
            for item in items:
                if item.get("separator"):
                    menu.append(Gtk.SeparatorMenuItem())
                    continue
                if item.get("checked") or item.get("toggle"):
                    widget = Gtk.CheckMenuItem(label=item["title"])
                    widget.set_active(bool(item.get("checked")))
                else:
                    widget = Gtk.MenuItem(label=item["title"])
                children = item.get("children")
                command = item.get("command")
                if children:
                    widget.set_submenu(self.build(children))
                is_label = command is None and not children and not item.get("checked")
                widget.set_sensitive(item.get("enabled", True) and not is_label)
                if command:
                    widget.connect("activate", lambda _w, c=command: self.perform(c))
                elif item.get("checked"):
                    # The account in use: keep its check mark when clicked.
                    widget.connect("toggled", lambda w: w.get_active() or w.set_active(True))
                menu.append(widget)
            menu.show_all()
            return menu

        def show_menu_for_screenshot(self):
            """Opens the menu below a tiny window, once that window is on screen."""
            anchor = Gtk.Window(title="Keyhop")
            anchor.set_decorated(False)
            anchor.set_default_size(1, 1)
            anchor.move(980, 16)
            menu = self.build(build_menu(self.status, self.busy, self.update, self.menu_settings()))
            self.anchor, self.screenshot_menu = anchor, menu

            def popup():
                menu.popup_at_widget(anchor, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)
                return False

            anchor.connect("map-event", lambda *_: GLib.timeout_add(300, popup) and False)
            anchor.show_all()
            return False

        # Actions

        def perform(self, command):
            kind = command[0]
            if fixture and kind not in ("rename", "remove", "budget", "quit"):
                return

            if kind == "switch":
                tool, account = find_account(self.status, command[1])
                if not tool:
                    return
                self.busy = f"Switching {tool['name']} to {account['name']}…"
                self.render()

                def done(code, stdout, stderr):
                    self.busy = None
                    if code == 0:
                        try:
                            result = json.loads(stdout)
                            if result.get("note"):
                                self.notify(result["message"], result["note"])
                        except ValueError:
                            pass
                    else:
                        self.notify(f"Couldn't switch {tool['name']}", self.error_text(code, stderr))
                    self.load(["status", "--json"])

                self.run(["switch", command[1], "--json"], done)

            elif kind == "add":
                tool = next((t for t in (self.status or {}).get("tools", []) if t["id"] == command[1]), None)
                if not tool:
                    return
                self.busy = f"Waiting for a new {tool['name']} login…"
                self.render()
                self.notify(f"Sign in to {tool['name']} with the other account", f"{tool['signInHint']} Keyhop saves it as soon as it appears.")

                def done(code, stdout, stderr):
                    self.busy = None
                    if code == 0:
                        try:
                            self.notify(tool["name"], json.loads(stdout)["message"])
                        except (ValueError, KeyError):
                            pass
                    else:
                        self.notify(f"No new {tool['name']} login saved", self.error_text(code, stderr))
                    self.load(["status", "--json"])

                self.run(["add", command[1], "--json"], done)

            elif kind == "refresh":
                self.refresh()

            elif kind == "dashboard":
                self.open_dashboard()

            elif kind == "rename":
                tool, account = find_account(self.status, command[1])
                if not tool:
                    return
                name = prompt("Rename account", f"A name for {account['email']} in {tool['name']}. Leave it empty to show the email.",
                              account.get("label") or "")
                if name is None or fixture:
                    return
                name = name.strip()
                arguments = ["rename", command[1], name] if name else ["rename", command[1], "--clear"]
                self.run(arguments, self.after_edit("Couldn't rename the account"))

            elif kind == "remove":
                tool, account = find_account(self.status, command[1])
                if not tool:
                    return
                if not confirm(f"Remove {account['name']} from {tool['name']}?",
                               "Keyhop deletes its saved login. The account itself isn't affected, and you can add it again by signing in.",
                               "Remove") or fixture:
                    return
                self.run(["remove", command[1]], self.after_edit("Couldn't remove the account"))

            elif kind == "budget":
                current = overall_budget(self.status)
                message = "A monthly budget for all accounts, in dollars at API prices. Keyhop warns at 80% and 100%. Leave it empty for no budget."
                answer = f"{current['amount']:.0f}" if current else ""
                while True:
                    typed = prompt("Budget", message, answer)
                    if typed is None:
                        return
                    amount = budget_amount(typed)
                    if amount is None:
                        message = "Type an amount in dollars, like 200, or leave it empty for no budget."
                        answer = typed
                        continue
                    break
                if fixture:
                    return
                arguments = ["budget", "set", "all", f"{amount:.2f}", "--period", "month"] if amount else ["budget", "clear", "all"]
                self.run(arguments, self.after_edit("Couldn't change the budget"))

            elif kind == "auto-refresh":
                self.settings["autoRefresh"] = not self.settings["autoRefresh"]
                self.render()

            elif kind == "auto-install":
                self.settings["autoInstallUpdates"] = not self.settings["autoInstallUpdates"]
                self.render()
                if self.settings["autoInstallUpdates"] and self.can_self_update:
                    self.install_update()

            elif kind == "autostart":
                if os.path.exists(autostart_file):
                    os.remove(autostart_file)
                else:
                    os.makedirs(os.path.dirname(autostart_file), exist_ok=True)
                    with open(autostart_file, "w", encoding="utf-8") as handle:
                        handle.write(
                            "[Desktop Entry]\nType=Application\nName=Keyhop\n"
                            f"Exec={os.path.realpath(__file__)}\nIcon={APP_ID}\n"
                            "X-GNOME-Autostart-enabled=true\nNoDisplay=true\n"
                        )
                self.render()

            elif kind == "check-update":
                self.check_update(announce=True)

            elif kind == "install-update":
                self.install_update()

            elif kind == "quit":
                Gtk.main_quit()

    Tray()
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        add_signal = GLibUnix.signal_add
    except (ValueError, ImportError):
        add_signal = GLib.unix_signal_add  # PyGObject before 3.52
    add_signal(GLib.PRIORITY_DEFAULT, 2, Gtk.main_quit)
    add_signal(GLib.PRIORITY_DEFAULT, 15, Gtk.main_quit)
    Gtk.main()
    return 0


def main(argv):
    if "--print-menu" in argv:
        index = argv.index("--print-menu")
        if index + 1 >= len(argv):
            sys.stderr.write("Usage: keyhop-tray --print-menu status.json\n")
            return 2
        print_menu(argv[index + 1])
        return 0
    if "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0
    return run_tray(argv)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
